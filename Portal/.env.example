# URL de Postgres de Supabase (pooler). En Vercel la integración la inyecta sola;
# en local, copia este archivo a .env.local o corre `vercel env pull .env.local`.
NEXT_PUBLIC_STORAGE_SUPABASE_ANON_KEY=""
STORAGE_SUPABASE_PUBLISHABLE_KEY=""
STORAGE_SUPABASE_URL=""
STORAGE_POSTGRES_DATABASE=""
STORAGE_POSTGRES_HOST=""
STORAGE_POSTGRES_PASSWORD=""
STORAGE_POSTGRES_PRISMA_URL=""
STORAGE_POSTGRES_URL=""
STORAGE_POSTGRES_URL_NON_POOLING=""
STORAGE_POSTGRES_USER="postgres"
NEXT_PUBLIC_STORAGE_SUPABASE_ANON_KEY=""
STORAGE_SUPABASE_JWT_SECRET=""
STORAGE_SUPABASE_PUBLISHABLE_KEY=""
STORAGE_SUPABASE_SECRET_KEY=""
STORAGE_SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_SUPABASE_URL=""
# Clave única del negocio para entrar a la app (requerida). Se define también en
# las variables del proyecto en Vercel; sin ella, ningún acceso es válido.
CLAVE_ACCESO="cambia-esta-clave"
